{
  "name": "wiki-multi-structure-render",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run preview:http\" \"npm run wait-on-preview-port && npm run dev:vite\"",
    "wait-on-preview-port": "node server/wiki-mock/wait-preview-port.mjs",
    "dev:vite": "vite",
    "dev:only": "vite",
    "preview:http": "tsx server/wiki-mock/preview-http.mjs",
    "serve:http": "node server/wiki-mock/preview-http.mjs --static dist",
    "local:http": "npm run build && npm run serve:http",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "three": "^0.174.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.21.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
