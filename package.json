{
  "name": "web-structure-renderer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && npm run build:all",
    "build:lib": "vite build",
    "build:workbench": "vite build --config vite.workbench.config.ts",
    "build:all": "npm run build:lib && npm run build:workbench",
    "export:huiji-workbench": "node scripts/huiji/export-workbench-pages.mjs",
    "build:huiji-workbench": "vite build --config vite.wiki-workbench.config.ts && npm run export:huiji-workbench",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/pako": "^2.0.4",
    "jszip": "^3.10.1",
    "pako": "^2.1.0",
    "snarkdown": "^2.0.0",
    "three": "^0.174.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
